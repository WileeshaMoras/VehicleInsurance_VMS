@{
    ViewData["Title"] = "Vehicle Management";
}

<h2>Vehicle Management</h2>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <a asp-controller="Vehicle" asp-action="Add" class="btn btn-primary btn-lg btn-block">Add Vehicle</a>
        </div>
        <div class="col-md-6">
            <a asp-controller="Vehicle" asp-action="View" asp-route-customerId="1" class="btn btn-primary btn-lg btn-block">View Vehicles</a>
        </div>
    </div>
</div>
